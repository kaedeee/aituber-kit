{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "peacock.color": "#604669",
  "workbench.colorCustomizations": {
    "tab.activeBorder": "#7c5a88",
    "statusBarItem.hoverBackground": "#7c5a88",
    "statusBarItem.remoteBackground": "#604669",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "activityBar.background": "#203304",
    "titleBar.activeBackground": "#2D4706",
    "titleBar.activeForeground": "#F5FDE9",
    "titleBar.inactiveBackground": "#243214",
    "titleBar.inactiveForeground": "#F9FBF6"
  }
}
